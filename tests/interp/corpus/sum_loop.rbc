# Sum 1..100 = 5050 with an explicit safepoint_poll on the backedge (the
# Rule 88 lowering convention; the polls are observable via InterpStats).

.class Main

.method static main ()V
.regs 5
.locals 2
.const c0 = field java/lang/System out Ljava/io/PrintStream;
.const c1 = method java/io/PrintStream println (I)V
iconst r0 0
istore r0 l0
iconst r0 1
istore r0 l1
Lcond:
iload r0 l1
iconst r1 101
if_icmpge r0 r1 Ldone
iload r0 l0
iload r1 l1
iadd r2 r0 r1
istore r2 l0
iload r3 l1
iinc r3 1
istore r3 l1
safepoint_poll
goto Lcond
Ldone:
getstatic r0 c0
iload r1 l0
invokevirtual r2 r0 r2 c1
return
.end
