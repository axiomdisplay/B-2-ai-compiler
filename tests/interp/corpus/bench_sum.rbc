# T1 benchmark + differential corpus entry (MSG-20260830-005): sum_loop's
# shape with the safepoint_poll AT the loop head, so the method compiles on
# T1 - the loop body exercises iload_iconst_if_icmpge,
# iload_iload_iadd_istore, and iload_iinc_istore (the whole loop is three
# fused instances + poll + goto).
# Positive corpus file: must parse, verify, and run under T0 with the exact
# expected stdout (Java semantics oracle, Rule 67).

.class Main

.method static main ()V
.regs 5
.locals 2
.const c0 = field java/lang/System out Ljava/io/PrintStream;
.const c1 = method java/io/PrintStream println (I)V
iconst r0 0
istore r0 l0
iconst r0 1
istore r0 l1
Lcond:
safepoint_poll
iload r0 l1
iconst r1 101
if_icmpge r0 r1 Ldone
iload r0 l0
iload r1 l1
iadd r2 r0 r1
istore r2 l0
iload r3 l1
iinc r3 1
istore r3 l1
goto Lcond
Ldone:
getstatic r0 c0
iload r1 l0
invokevirtual r2 r0 r2 c1
return
.end
