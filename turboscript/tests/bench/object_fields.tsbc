; bench: object_fields — object allocation + shape-transition stores and
; monomorphic IC loads. Per iteration: fresh object {a,b,c}, then read all
; three fields back. JS twin: object_fields.js (Rule 96 differential pair).
.module object_fields
.global @print
.entry @main

.const @cN = 1000000
.const @sA = "a"
.const @sB = "b"
.const @sC = "c"
.const @sLabel = "object_fields"

.function @main 0 16
  LoadGlobal r0, @print
  LoadConst r1, @cN           ; N
  LoadConstS r2, 2            ; 2
  LoadConstS r3, 3            ; 3
  LoadConst r4, @sA           ; "a"
  LoadConst r5, @sB           ; "b"
  LoadConst r6, @sC           ; "c"
  LoadConstS r7, 0            ; i = 0
  LoadConstS r8, 0            ; acc = 0
  LoadConstS r14, 0           ; zero
.Lloop:
  NewObject r9                ; o = {}
  SetProperty r9, r4, r7      ; o.a = i
  Mov r10, r7
  Mul r10, r2                 ; i * 2
  SetProperty r9, r5, r10     ; o.b = i*2
  Mov r10, r7
  Mul r10, r3                 ; i * 3
  SetProperty r9, r6, r10     ; o.c = i*3
  GetProperty r11, r9, r4     ; o.a
  GetProperty r12, r9, r5     ; o.b
  GetProperty r13, r9, r6     ; o.c
  Add r8, r11
  Add r8, r12
  Add r8, r13
  BitOr r8, r14               ; acc = (acc + a + b + c) | 0
  Inc r7                      ; i++
  Mov r10, r7
  Lt r10, r1
  JmpTrue r10, .Lloop
  LoadConst r10, @sLabel
  Mov r11, r8
  Call r0, r10, 2, r12        ; print("object_fields", acc)
  Return r12
.end
