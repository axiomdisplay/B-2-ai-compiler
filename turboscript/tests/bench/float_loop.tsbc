; bench: float_loop — mandelbrot-lite iteration counts on a 200x200 grid.
; Pure IEEE-754 double arithmetic; escape counts are bit-identical across
; engines, so the checksum is a cross-engine differential oracle (Rule 96).
; JS twin: float_loop.js.
.module float_loop
.global @print
.entry @main

.const @cN = 200
.const @cStep = 0.005
.const @cYoff = 1.5
.const @cXoff = 0.5
.const @cFour = 4.0
.const @sLabel = "float_loop"

.function @main 0 24
  LoadGlobal r0, @print
  LoadConst r1, @cN           ; N (grid)
  LoadConst r2, @cStep        ; 0.005
  LoadConst r3, @cYoff        ; 1.5
  LoadConst r4, @cXoff        ; 0.5
  LoadConst r5, @cFour        ; 4.0
  LoadConstS r6, 100          ; maxIt
  LoadConstS r7, 2            ; two
  LoadConstS r8, 0            ; zero
  LoadConstS r9, 0            ; acc = 0
  LoadConstS r10, 0           ; py = 0
.Louter:
  Mov r11, r10
  Mul r11, r2
  Sub r11, r3                 ; y0 = py * 0.005 - 1.5
  Mov r12, r11                ; r12 = y0
  LoadConstS r11, 0           ; px = 0
.Linner:
  Mov r13, r11
  Mul r13, r2
  Sub r13, r4                 ; x0 = px * 0.005 - 0.5
  Mov r14, r8                 ; x = 0
  Mov r15, r8                 ; y = 0
  Mov r16, r8                 ; it = 0
.Lwhile:
  Mov r17, r14
  Mul r17, r14                ; x*x
  Mov r18, r15
  Mul r18, r15                ; y*y
  Add r17, r18                ; x*x + y*y
  Le r17, r5                  ; <= 4.0
  JmpFalse r17, .Lend
  Mov r17, r16
  Lt r17, r6                  ; it < 100
  JmpFalse r17, .Lend
  Mov r17, r14
  Mul r17, r14                ; x*x
  Mov r18, r15
  Mul r18, r15                ; y*y
  Sub r17, r18                ; x*x - y*y
  Add r17, r13                ; + x0        (xt)
  Mov r18, r7                 ; 2
  Mul r18, r14                ; 2*x
  Mul r18, r15                ; 2*x*y
  Add r18, r12                ; + y0
  Mov r15, r18                ; y = 2xy + y0
  Mov r14, r17                ; x = xt
  Inc r16                     ; it++
  Jmp .Lwhile
.Lend:
  Add r9, r16                 ; acc += it
  Inc r11                     ; px++
  Mov r17, r11
  Lt r17, r1
  JmpTrue r17, .Linner
  Inc r10                     ; py++
  Mov r17, r10
  Lt r17, r1
  JmpTrue r17, .Louter
  LoadConst r17, @sLabel
  Mov r18, r9
  Call r0, r17, 2, r19        ; print("float_loop", acc)
  Return r19
.end
