; V0.2 arrays: key routing. Canonical numeric strings ("1") are array
; indices (ToPropertyKey of a Smi produces exactly that form), so string and
; number keys address the SAME element. Non-canonical forms ("01") are named
; properties: they never touch elements or length.
.module arrays
.global @print
.const @KS1 = "1"
.const @KS01 = "01"
.const @KLEN = "length"
.entry @main

.function @main 0 12
  LoadGlobal r9, @print

  NewArray r1
  LoadConst r2, @KS1
  LoadConstS r3, 5
  SetElement r1, r2, r3         ; arr["1"] = 5  (element, length -> 2)

  LoadConstS r2, 1
  GetElement r4, r1, r2
  Call r9, r4, 1, r0            ; 5 (number key hits the same element)

  LoadConst r2, @KS01
  LoadConstS r3, 7
  SetProperty r1, r2, r3        ; arr["01"] = 7 (NAMED property)

  LoadConst r2, @KS01
  GetElement r4, r1, r2
  Call r9, r4, 1, r0            ; 7
  LoadConst r2, @KS01
  HasProperty r4, r1, r2
  Call r9, r4, 1, r0            ; true
  LoadConst r2, @KLEN
  GetProperty r4, r1, r2
  Call r9, r4, 1, r0            ; 2 (named prop did not change length)

  LoadConst r2, @KS01
  HasProperty r4, r1, r2
  Call r9, r4, 1, r0            ; true (own named)

  Return r0
.end
