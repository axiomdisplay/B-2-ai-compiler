; V0.2 arrays: length grows when storing past the end (ECMA-262: "if idx >=
; length, set length to idx+1"); the gap slots [0..4] become holes -> reads
; fall through the prototype chain (null here) to undefined, and "0 in arr"
; is false. Also proves stores beyond length make the array holey.
.module arrays
.global @print
.const @KLEN = "length"
.const @K0 = "0"
.const @K5 = "5"
.entry @main

.function @main 0 10
  LoadGlobal r8, @print

  NewArray r1
  LoadConstS r2, 42
  LoadConstS r3, 5
  SetElement r1, r3, r2         ; arr[5] = 42  (length becomes 6)

  LoadConst r3, @KLEN
  GetProperty r4, r1, r3
  Call r8, r4, 1, r0            ; 6

  LoadConstS r3, 5
  GetElement r4, r1, r3
  Call r8, r4, 1, r0            ; 42

  LoadConstS r3, 0
  GetElement r4, r1, r3
  Call r8, r4, 1, r0            ; undefined (hole)

  LoadConst r3, @K0
  HasProperty r4, r1, r3
  Call r8, r4, 1, r0            ; false ("0" in arr: hole is not own)

  LoadConst r3, @K5
  HasProperty r4, r1, r3
  Call r8, r4, 1, r0            ; true

  Return r0
.end
