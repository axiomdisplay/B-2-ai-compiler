; V0.2 arrays: elements-kind transition PackedSmi -> PackedDouble. The kind
; invariant is enforced on store: a Smi-kind array that receives 3.5 widens
; to double elements; every value stays readable and unchanged.
.module arrays
.global @print
.const @KLEN = "length"
.entry @main

.function @main 0 8
  LoadGlobal r7, @print

  NewArray r1
  LoadConstS r2, 1
  LoadConstS r3, 0
  SetElement r1, r3, r2         ; arr[0] = 1   (PackedSmi)
  LoadConstS r2, 2
  LoadConstS r3, 1
  SetElement r1, r3, r2         ; arr[1] = 2   (still PackedSmi)
  LoadConst r2, @CD
  LoadConstS r3, 2
  SetElement r1, r3, r2         ; arr[2] = 3.5 (-> PackedDouble)

  LoadConstS r3, 0
  GetElement r4, r1, r3
  Call r7, r4, 1, r0            ; 1
  LoadConstS r3, 1
  GetElement r4, r1, r3
  Call r7, r4, 1, r0            ; 2
  LoadConstS r3, 2
  GetElement r4, r1, r3
  Call r7, r4, 1, r0            ; 3.5

  LoadConst r3, @KLEN
  GetProperty r4, r1, r3
  Call r7, r4, 1, r0            ; 3

  Return r0
.end

.const @CD = 3.5
