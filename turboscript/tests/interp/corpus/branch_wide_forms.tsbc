; Wide conditional branch forms: >127 words forces JmpFalseWide
; (assembler picks the encoding; both dispatch paths must decode identically).
; Statically every instruction is reachable (no dead code, Rule 60).
.module wide
.global @print
.entry @main

.function @main 0 6
  LoadGlobal r5, @print
  LoadTrue r1
  JmpFalse r1, .Lfar    ; never taken at runtime, but encodes WIDE
    Nop
