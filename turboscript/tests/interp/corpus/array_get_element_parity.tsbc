; V0.2 arrays: GetElement/GetElement-opcode and GetProperty/GetProperty-opcode
; share ONE semantic source (Rule 96). Every case below computes the value
; twice — once through the keyed opcode, once through the named opcode — and
; asserts StrictEq. Covers index hit, string-index hit, named hit, length,
; and misses.
.module arrays
.global @print
.const @KLEN = "length"
.const @KFOO = "foo"
.const @KS1 = "1"
.entry @main

.function @main 0 14
  LoadGlobal r9, @print

  NewArray r1
  LoadConstS r2, 5
  LoadConstS r3, 1
  SetElement r1, r3, r2         ; arr[1] = 5
  LoadConst r2, @KFOO
  LoadConstS r3, 6
  SetProperty r1, r2, r3        ; arr.foo = 6

  ; case 1: numeric index 1
  LoadConstS r2, 1
  GetElement r4, r1, r2
  GetProperty r5, r1, r2
  StrictEq r4, r5
  Call r9, r4, 1, r0            ; true

  ; case 2: canonical string "1"
  LoadConst r2, @KS1
  GetElement r4, r1, r2
  GetProperty r5, r1, r2
  StrictEq r4, r5
  Call r9, r4, 1, r0            ; true

  ; case 3: named property foo
  LoadConst r2, @KFOO
  GetElement r4, r1, r2
  GetProperty r5, r1, r2
  StrictEq r4, r5
  Call r9, r4, 1, r0            ; true

  ; case 4: exotic length
  LoadConst r2, @KLEN
  GetElement r4, r1, r2
  GetProperty r5, r1, r2
  StrictEq r4, r5
  Call r9, r4, 1, r0            ; true

  ; case 5: miss (absent index 9) — both undefined
  LoadConstS r2, 9
  GetElement r4, r1, r2
  GetProperty r5, r1, r2
  StrictEq r4, r5
  Call r9, r4, 1, r0            ; true

  Return r0
.end
