; V0.2 arrays: length is writable but NON-CONFIGURABLE. delete arr.length
; returns false (DeleteProperty opcode, strict semantics) while "length in
; arr" stays true. Deleting an absent element returns true and does not
; change length.
.module arrays
.global @print
.const @KLEN = "length"
.const @K9 = "9"
.entry @main

.function @main 0 10
  LoadGlobal r8, @print

  NewArray r1
  LoadConstS r2, 7
  LoadConstS r3, 0
  SetElement r1, r3, r2         ; arr = [7]

  LoadConst r3, @KLEN
  DeleteProperty r4, r1, r3
  Call r8, r4, 1, r0            ; false (non-configurable)

  HasProperty r4, r1, r3
  Call r8, r4, 1, r0            ; true (length still there)

  GetProperty r5, r1, r3
  Call r8, r5, 1, r0            ; 1

  LoadConst r3, @K9
  DeleteProperty r4, r1, r3
  Call r8, r4, 1, r0            ; true (absent element: success no-op)
  LoadConst r3, @KLEN
  GetProperty r5, r1, r3
  Call r8, r5, 1, r0            ; 1 (unchanged)

  Return r0
.end
