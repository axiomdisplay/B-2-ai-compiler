; V0.2 arrays: NewArray, SetElement/GetElement, exotic length via GetProperty,
; own-element routing for numeric keys; fresh array proto is null.
.module arrays
.global @print
.const @KLEN = "length"
.entry @main

.function @main 0 10
  LoadGlobal r9, @print

  NewArray r1                   ; []  (PackedSmi, length 0)
  LoadConstS r2, 10
  LoadConstS r3, 0
  SetElement r1, r3, r2         ; arr[0] = 10
  LoadConstS r2, 20
  LoadConstS r3, 1
  SetElement r1, r3, r2         ; arr[1] = 20
  LoadConstS r2, 30
  LoadConstS r3, 2
  SetElement r1, r3, r2         ; arr[2] = 30

  LoadConstS r3, 0
  GetElement r4, r1, r3
  Call r9, r4, 1, r0            ; 10
  LoadConstS r3, 1
  GetElement r4, r1, r3
  Call r9, r4, 1, r0            ; 20
  LoadConstS r3, 2
  GetElement r4, r1, r3
  Call r9, r4, 1, r0            ; 30

  LoadConst r3, @KLEN
  GetProperty r4, r1, r3        ; arr.length (exotic property)
  Call r9, r4, 1, r0            ; 3

  GetPrototype r4, r1
  Call r9, r4, 1, r0            ; null (proto pending builtins)

  Return r0
.end
