; V0.2 arrays: holey-double kind. delete hole-ifies (PackedSmi -> HoleySmi),
; a subsequent double store widens to HoleyDouble, and the hole keeps
; resolving through the chain (undefined with a null proto) while neighbors
; stay intact. Proves kinds transition independently of packed/holey state.
.module arrays
.global @print
.const @KLEN = "length"
.entry @main

.function @main 0 10
  LoadGlobal r8, @print

  NewArray r1
  LoadConstS r2, 1
  LoadConstS r3, 0
  SetElement r1, r3, r2         ; arr[0] = 1
  LoadConstS r2, 2
  LoadConstS r3, 1
  SetElement r1, r3, r2         ; arr[1] = 2  (PackedSmi, dense [1,2])

  LoadConstS r3, 0
  DeleteProperty r4, r1, r3     ; delete arr[0] -> HoleySmi

  LoadConst r2, @CD
  LoadConstS r3, 1
  SetElement r1, r3, r2         ; arr[1] = 2.5 -> HoleyDouble

  LoadConstS r3, 0
  GetElement r4, r1, r3
  Call r8, r4, 1, r0            ; undefined (hole survives widening)

  LoadConstS r3, 1
  GetElement r4, r1, r3
  Call r8, r4, 1, r0            ; 2.5

  LoadConst r3, @KLEN
  GetProperty r4, r1, r3
  Call r8, r4, 1, r0            ; 2

  Return r0
.end

.const @CD = 2.5
